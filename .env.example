# Integration Test Configuration
#
# Copy this file to .env and fill in your values.
#
# ─────────────────────────────────────────────────────────────────────────────
# Browser Provider (choose one)
# ─────────────────────────────────────────────────────────────────────────────

# Local browser (default)
BROWSER_MODE=local
# Optional: Override Chrome path if auto-detection fails
# CHROME_PATH=/path/to/chrome

# Steel.dev browser provider
# BROWSER_MODE=remote
# STEEL_API_KEY=your_steel_api_key

# Browserbase browser provider
# BROWSER_MODE=remote
# BROWSERBASE_API_KEY=your_browserbase_api_key

# Cloudflare Browser Run provider
# BROWSER_MODE=remote
# CF_ACCOUNT_ID=your_cloudflare_account_id
# CF_API_TOKEN=your_cloudflare_api_token

# Custom CDP endpoint
# BROWSER_MODE=remote
# CDP_URL=ws://localhost:9222

# ─────────────────────────────────────────────────────────────────────────────
# LLM Provider (for Stagehand AI operations)
# ─────────────────────────────────────────────────────────────────────────────
# Model format: provider/model-name (e.g., openai/gpt-4o, mistral/mistral-medium-2508)
LLM_MODEL=mistral/mistral-medium-2508
LLM_API_KEY=your_llm_api_key

# Optional: Custom base URL for local LLM or proxy
# LLM_BASE_URL=http://localhost:11434/v1

# ─────────────────────────────────────────────────────────────────────────────
# Optional Settings
# ─────────────────────────────────────────────────────────────────────────────

# Verbose logging (0=quiet, 1=normal, 2=debug)
# LLM_VERBOSE=1
