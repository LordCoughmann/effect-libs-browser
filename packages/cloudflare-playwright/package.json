{
  "name": "@effect-libs/cloudflare-playwright",
  "version": "0.0.0",
  "description": "Patched fork of @cloudflare/playwright@1.3.0 with external CDP support, lazy cloudflare:workers import, ESM type resolution, and graceful orphaned-session handling. Vendored from upstream Cloudflare, maintained inside the @effect-libs/browser monorepo.",
  "homepage": "https://github.com/LordCoughmann/effect-libs-browser/tree/main/packages/cloudflare-playwright#readme",
  "bugs": {
    "url": "https://github.com/LordCoughmann/effect-libs-browser/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/LordCoughmann/effect-libs-browser.git",
    "directory": "packages/cloudflare-playwright"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./lib/index.js"
    },
    "./test": {
      "types": "./test.d.ts",
      "default": "./lib/test.js"
    },
    "./internal": {
      "types": "./internal.d.ts",
      "default": "./lib/internal.js"
    },
    "./types/types": {
      "types": "./types/types.d.ts"
    }
  },
  "files": [
    "index.d.ts",
    "internal.d.ts",
    "test.d.ts",
    "lib",
    "types",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "echo 'Pre-built vendored artifacts; no build step.' && exit 0",
    "sync:upstream": "./scripts/sync-upstream.sh"
  },
  "keywords": [
    "playwright",
    "cloudflare",
    "fork",
    "effect-libs",
    "browser-automation",
    "cdp"
  ]
}
