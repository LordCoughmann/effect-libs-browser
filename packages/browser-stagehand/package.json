{
  "name": "@effect-libs/browser-stagehand",
  "version": "1.0.0",
  "description": "AI-powered browser automation (Stagehand v3) module for @effect-libs/browser. Wraps act/extract/observe on edge runtimes.",
  "homepage": "https://github.com/LordCoughmann/effect-libs-browser/tree/main/packages/browser-stagehand#readme",
  "bugs": {
    "url": "https://github.com/LordCoughmann/effect-libs-browser/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LordCoughmann/effect-libs-browser.git",
    "directory": "packages/browser-stagehand"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "source": "./src/index.ts"
    },
    "./ws": {
      "types": "./dist/polyfills/ws.d.ts",
      "import": "./dist/polyfills/ws.js",
      "source": "./src/polyfills/ws.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@effect-libs/browser": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@browserbasehq/stagehand": "^3.0.0",
    "effect": "catalog:"
  }
}
