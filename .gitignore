# Generated by Wrangler
worker-configuration.d.ts

# Stub re-exports emitted by tsdown + rolldown-plugin-dts into src/ during
# a multi-package build (tsdown issue with typescript@7's tsgo generator;
# deferred — see `.local/PRE_RELEASE_TODO.md` "Last priority — research
# offline" section). The dist/*.d.ts bundles are the source of truth and
# are already covered by the `dist/` rule above; these src/ stubs add
# no value to consumers (monorepo resolves via path aliases to .ts).
packages/*/src/**/*.d.ts

# Vendored reference repositories (for coding agents; not part of the published library)
repos/


.tmp/
tmp/